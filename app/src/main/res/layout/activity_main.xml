<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen map (MapLibre + Maptoolkit tiles) -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bluetooth connection status bar (placeholder button).
         Full width, square corners; extends under the system status bar
         (top padding is added from window insets in MainActivity). -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bluetoothStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clickable="true"
        android:contentDescription="@string/bluetooth_status_description"
        android:focusable="true"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/bluetoothStatusContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/bluetoothIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bluetooth"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/bluetoothStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/bluetooth_status_disconnected"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <View
                android:id="@+id/bluetoothStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/status_dot"
                android:backgroundTint="@color/status_disconnected" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Create route (placeholder) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/createRouteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="@string/create_route"
        app:icon="@drawable/ic_route" />

</FrameLayout>
